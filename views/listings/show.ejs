<% layout("/layouts/boilerplate") %>
<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="row mt-3 justify-content-center">
    <!-- Listing Title -->
    <div class="col-12 col-md-10 col-lg-8">
        <h3><%= listing.title %></h3>
    </div>

    <!-- Listing Main Card -->
    <div class="card col-12 col-md-10 col-lg-8 show-card listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
        <div class="card-body">
            <p class="card-text">
                Owned by <i><b><%= listing.owner.username %></b></i>
            </p>
            <p class="card-text"><%= listing.description %></p>
            <p class="card-text">
                ₹<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night
            </p>
            <p class="card-text"><%= listing.location %></p>
            <p class="card-text"><%= listing.country %></p>
        </div>
    </div>

    <!-- Edit & Delete Buttons (Responsive) -->
    <% if (currUser && listing.owner._id.equals(currUser._id)) { %>
        <div class="col-12 col-md-10 col-lg-8 mt-3 d-flex gap-3">
            <a href="/listings/<%= listing.id %>/edit" class="btn btn-dark edit-btn px-4">Edit</a>
            <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
                <button class="btn btn-dark px-4">Delete</button>
            </form>
        </div>
    <% } %>

    <!-- Leave a Review Form -->
    <div class="col-12 col-md-10 col-lg-8 mb-3">
        <% if(currUser) { %>
            <hr>
            <h4>Leave a Review</h4>
            <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
                <div class="mb-3 mt-3 rating">
                    <label class="form-label">Rating</label><br>
                    <input type="radio" id="star5" name="review[rating]" value="5">
                    <label for="star5">★</label>
                    <input type="radio" id="star4" name="review[rating]" value="4">
                    <label for="star4">★</label>
                    <input type="radio" id="star3" name="review[rating]" value="3">
                    <label for="star3">★</label>
                    <input type="radio" id="star2" name="review[rating]" value="2">
                    <label for="star2">★</label>
                    <input type="radio" id="star1" name="review[rating]" value="1">
                    <label for="star1">★</label>
                </div>

                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comments</label>
                    <textarea name="review[comment]" id="comment" rows="4" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please add some comments for review</div>
                </div>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
        <% } %>

        <hr>

        <!-- All Reviews (Responsive Grid: मोबाइल पर 1 कॉलम, बड़ी स्क्रीन पर 2 कॉलम) -->
        <% if(listing.reviews.length > 0) { %>
            <p><b>All Reviews</b></p>
            <div class="row g-3">
                <% for (review of listing.reviews) { %>
                    <div class="col-12 col-md-6">
                        <div class="card h-100 p-2">
                            <div class="card-body">
                                <h5 class="card-title">@<%= review.author.username %></h5>
                                <p class="card-text text-warning fs-5">
                                    <% for(let i=1; i <= 5; i++) { %>
                                        <%= i <= review.rating ? "★" : "☆" %>
                                    <% } %>
                                </p>
                                <p class="card-text"><%= review.comment %></p>
                            </div>

                            <!-- केवल Review Author ही Delete कर सकेगा -->
                            <% if(currUser && review.author._id.equals(currUser._id)) { %>
                                <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="px-3 pb-2" method="POST">
                                    <button class="btn btn-sm btn-dark">Delete</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>

    <!-- Map Section -->
    <div class="col-12 col-md-10 col-lg-8 mb-4">
        <h3>Where you'll be</h3>
        <div id="map"></div>
    </div>
</div>

<script src="/JS/map.js"></script>
