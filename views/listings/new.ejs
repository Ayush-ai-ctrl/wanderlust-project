<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-5 justify-content-center">
  <div class="col-12 col-md-10 col-lg-8">
    <h2 class="mb-4">Create a New Listing</h2>

    <form action="/listings" method="POST" class="needs-validation" novalidate enctype="multipart/form-data">

      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input
          id="title"
          name="listing[title]"
          placeholder="Enter Title"
          type="text"
          class="form-control"
          required
        />
        <div class="invalid-feedback">
          Please enter a title.
        </div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea
          id="description"
          name="listing[description]"
          rows="4"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">
          Please enter a description.
        </div>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Upload Image</label>
        <input
          id="image"
          name="listing"
          type="file"
          class="form-control"
          required
        />
        <div class="invalid-feedback">
          Please upload a listing image.
        </div>
      </div>

      <div class="row">
        <div class="mb-3 col-12 col-md-4">
          <label for="price" class="form-label">Price</label>
          <input
            id="price"
            name="listing[price]"
            placeholder="Enter Price"
            type="number"
            min="0"
            class="form-control"
            required
          />
          <div class="invalid-feedback">
            Please enter a valid price.
          </div>
        </div>

        <div class="mb-3 col-12 col-md-8">
          <label for="country" class="form-label">Country</label>
          <input
            id="country"
            name="listing[country]"
            placeholder="Enter Country"
            type="text"
            class="form-control"
            required
          />
          <div class="invalid-feedback">
            Please enter a valid country.
          </div>
        </div>
      </div>

      <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <input
          id="location"
          name="listing[location]"
          placeholder="Enter Location"
          type="text"
          class="form-control"
          required
        />
        <div class="invalid-feedback">
          Please enter a valid location.
        </div>
      </div>

      <button type="submit" class="btn btn-dark add-btn mt-3 px-4 w-100 w-md-auto">
        Add Listing
      </button>
    </form>
  </div>
</div>
